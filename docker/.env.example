# Copy to docker/.env and fill in. docker/.env is gitignored — never commit real keys.

# --- Model provider: set ONE block ------------------------------------------
# OpenAI:
# OPENAI_API_KEY=sk-...
#
# Anthropic:
# ANTHROPIC_API_KEY=sk-ant-...
#
# Nebius Token Factory (OpenAI-compatible) or any OpenAI-compatible endpoint:
# OPENAI_API_KEY=...
# OPENAI_BASE_URL=https://api.studio.nebius.com/v1

# --- gog (Google Workspace CLI) encrypted file keyring ----------------------
# Any passphrase; it encrypts the stored Google OAuth tokens inside the container.
GOG_KEYRING_PASSWORD=change-me-to-a-long-random-string
